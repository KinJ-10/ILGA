/*
 * nRF54L15 DK temporary I2C overlay for BMI270 bring-up.
 *
 * TAG wiring for the nRF54L15 port:
 * - P1.11 = I2C SCL
 * - P1.12 = I2C SDA
 */

&pinctrl {
        i2c21_default: i2c21_default {
                group1 {
                        psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
                                <NRF_PSEL(TWIM_SCL, 1, 11)>;
                        bias-pull-up;
                };
        };

        i2c21_sleep: i2c21_sleep {
                group1 {
                        psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
                                <NRF_PSEL(TWIM_SCL, 1, 11)>;
                        low-power-enable;
                };
        };
};

&i2c21 {
        pinctrl-0 = <&i2c21_default>;
        pinctrl-1 = <&i2c21_sleep>;
        pinctrl-names = "default", "sleep";
        zephyr,concat-buf-size = <260>;
        zephyr,flash-buf-max-size = <260>;
        status = "okay";

        bmi270@68 {
                compatible = "bosch,bmi270";
                reg = <0x68>;
                status = "okay";
        };
};
